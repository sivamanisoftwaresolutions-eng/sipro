{
  "name": "sipro-tech",
  "version": "1.0.0",
  "type": "module",
  "description": "SiPro Tech - Digital systems and talent platform",
  "scripts": {
    "dev": "tsx server.ts",
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/input.css -o ./public_html/css/tailwind.min.css --minify",
    "build:js": "esbuild src/landing.ts --bundle --minify --outfile=public_html/js/landing.min.js",
    "build": "npm run build:css && npm run build:js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
